# --- App ---
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=seo_crawl
QDRANT_VECTOR_SIZE=768

# App uses QDRANT_URL internally; compose builds it from host/port.
# QDRANT_URL=http://qdrant:6333

# --- Local Qwen via Ollama ---
# Dev-friendly names
QWEN_BASE_URL=http://host.docker.internal:11434
QWEN_MODEL_NAME=qwen2.5:7b-instruct
QWEN_EMBED_MODEL=nomic-embed-text

# The app expects Ollama env var names (mapped from QWEN_* in compose)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_EMBED_MODEL=nomic-embed-text

# --- FireCrawl (optional, for ingestion) ---
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_API_KEY=

# --- Playwright ingestion (primary ingestion path) ---
# NOTE: local dev requires browser install:
#   python -m playwright install chromium
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAV_TIMEOUT_MS=30000
PLAYWRIGHT_USER_AGENT=

# --- Content validation ---
# Pipe-separated substrings to ban (case-insensitive)
BANNED_AI_PHRASES=as an ai language model|as an ai|i cannot|delve into|game-changer|leverage synergies|unlock the power|in today's digital landscape|revolutionize your workflow|best of the best|ultimate|fantastic|incredible|state-of-the-art|cutting-edge|next-level|seamlessly|effortlessly|one-stop|world-class

# --- Runtime tuning ---
UVICORN_WORKERS=1
UVICORN_TIMEOUT_KEEP_ALIVE=5
